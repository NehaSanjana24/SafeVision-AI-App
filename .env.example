# GEMINI_API_KEY: Optional server-side Gemini AI key. Injected automatically by AI Studio.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SafeVision AI Optional Environment Configurations (Browser Client):
# 1. Custom YOLOv8 best.pt endpoint (default: https://safevision-yolo-api-2.onrender.com)
VITE_INFERENCE_API_URL="https://safevision-yolo-api-2.onrender.com"

# 2. Client-side Gemini API key for multimodal vision & agent (optional demo use)
VITE_GEMINI_API_KEY=""
VITE_GEMINI_MODEL="gemini-2.5-flash"

# 3. LangGraph Agent FastAPI backend server URL (optional, defaults to client-side StateGraph)
VITE_AGENT_API_URL=""

# 4. Supervisor Alert Webhook (Slack, Teams, or Custom HTTP POST JSON endpoint)
VITE_ALERT_WEBHOOK_URL=""

# 5. Firebase Authentication & Firestore (optional, falls back to Web Crypto demo auth)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
